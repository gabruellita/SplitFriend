<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GateWay.API</RootNamespace>
    <UserSecretsId>215d4d0e-2761-469f-b47e-4b6f572296a8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP — reverse proxy oficial Microsoft -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
    <!-- JWT Bearer Authentication + TokenValidationParameters.
         NU pinna Microsoft.IdentityModel.Tokens separat: JwtBearer 10.0.0 aduce
         tranzitiv intreaga familie Microsoft.IdentityModel.* la versiuni consistente
         (8.0.1). Un pin manual (ex. Tokens 8.9.0) dezaliniaza Tokens fata de
         JsonWebTokens (8.0.1) si arunca MissingMethodException la validarea token-ului. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GateWay.DTO\GateWay.DTO.csproj" />
    <ProjectReference Include="..\GateWay.Infrastructure\GateWay.Infrastructure.csproj" />
    <ProjectReference Include="..\GateWay.Services\GateWay.Services.csproj" />
  </ItemGroup>

</Project>
