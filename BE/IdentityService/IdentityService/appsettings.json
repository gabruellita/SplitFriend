{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "SecretKey":              "",
    "Issuer":                 "FinanceApp.IdentityService",
    "Audience":               "FinanceApp.Clients",
    "ExpiryMinutes":          15,
    "RefreshTokenExpiryDays": 7
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Smtp": {
    "Host":      "localhost",
    "Port":      1025,
    "FromEmail": "noreply@financeapp.local",
    "FromName":  "FinanceApp"
  },
  "Notification": {
    "BaseUrl": "http://localhost:5005"
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Logging": {
    "LogLevel": {
      "Default":              "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
