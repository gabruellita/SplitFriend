        { "name": "GET calendar", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/statistics/calendar?from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "path": ["api","statistics","calendar"], "query": [{ "key": "from", "value": "2026-01-01" }, { "key": "to", "value": "2026-12-31" }] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }] },
        { "name": "GET histogram", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/statistics/histogram?from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "path": ["api","statistics","histogram"], "query": [{ "key": "from", "value": "2026-01-01" }, { "key": "to", "value": "2026-12-31" }] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }] },
