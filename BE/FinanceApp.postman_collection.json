      ]
    },
    {
      "name": "05 - Chat (REST)",
      "item": [
        { "name": "GET messages (istoric)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/chat/groups/{{groupId}}/messages?limit=50", "host": ["{{baseUrl}}"], "path": ["api","chat","groups","{{groupId}}","messages"], "query": [{ "key": "limit", "value": "50" }] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }] },
        { "name": "GET unread", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/chat/unread", "host": ["{{baseUrl}}"], "path": ["api","chat","unread"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }] }
      ]
    },
    {
      "name": "06 - Export (PDF)",
      "item": [
        {
          "name": "POST report (RANGE, toate blocurile)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mode\": \"RANGE\",\n  \"range\": { \"from\": \"2026-01-01\", \"to\": \"2026-12-31\" },\n  \"blocks\": [\"SUMMARY\", \"TREND\", \"CATEGORIES\", \"TRANSACTIONS\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/export/report", "host": ["{{baseUrl}}"], "path": ["api","export","report"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('raspuns PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
          ] } }]
        }
      ]
    },
    {
      "name": "07 - Sesiune (refresh + logout)",
      "item": [
        {
          "name": "POST refresh (rotatie token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"refreshToken\": \"{{refreshToken}}\" }" },
            "url": { "raw": "{{baseUrl}}/api/identity/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","identity","auth","refresh"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "pm.test('pereche noua de token-uri', () => { pm.expect(d.accessToken).to.be.a('string'); pm.expect(d.refreshToken).to.be.a('string'); });",
            "pm.collectionVariables.set('accessToken', d.accessToken);",
            "pm.collectionVariables.set('refreshToken', d.refreshToken);"
          ] } }]
        },
        {
          "name": "POST logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"refreshToken\": \"{{refreshToken}}\" }" },
            "url": { "raw": "{{baseUrl}}/api/identity/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","identity","auth","logout"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK (sesiune revocata)', () => pm.response.to.have.status(200));"
          ] } }]
        }
      ]
    }
  ]
}
